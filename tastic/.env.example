EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LLM 키는 클라이언트(.env)가 아니라 Edge Function 시크릿으로만 관리한다.
# 서버는 DeepSeek(질문/평론/분석/첫질문) + OpenAI(verify-content/recommend-content 웹서치)를 사용.
# 설정: supabase secrets set DEEPSEEK_API_KEY=... OPENAI_API_KEY=...

# RevenueCat 공개 SDK 키 (클라이언트 노출 안전). 대시보드 → API keys → App별 Public key.
# 비어 있으면 해당 플랫폼 결제 자동 비활성. iOS 우선 테스트 → iOS 키만 채움.
# Android(Google Play)는 사업자등록 후 goog_ 키 추가하면 코드 변경 없이 활성화됨.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# 웹훅 Edge Function 시크릿 (supabase secrets set으로 설정, .env 아님):
# REVENUECAT_WEBHOOK_SECRET=...

# Sentry 크래시 리포팅 — 프로젝트 DSN (공개 가능). Sentry → Project Settings → Client Keys(DSN).
# 미설정 시 Sentry 자동 비활성.
EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# 소스맵 업로드용 (EAS 빌드 시크릿으로 설정, .env 아님):
# SENTRY_ORG=...  SENTRY_PROJECT=...  SENTRY_AUTH_TOKEN=...
